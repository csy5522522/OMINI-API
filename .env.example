HOST=127.0.0.1
DEV_HOST=127.0.0.1
DOCKER_BIND_ADDRESS=127.0.0.1
PORT=3001
SECONDARY_PORT=3002
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ENCRYPTION_KEY=
SESSION_SECRET=
# setup generates these passwords and complete connection URLs.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=
DATABASE_URL=mysql://observatory:CHANGE_ME@127.0.0.1:3306/observatory
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0
REDIS_PREFIX=relay
PROCESS_ROLE=all
CACHE_TTL_SECONDS=10
APP_TIMEZONE=Asia/Shanghai
SYNC_INTERVAL_SECONDS=300
COOKIE_SECURE=false
ALLOW_PRIVATE_HOSTS=
FX_PROVIDER=none
