{
  "name": "sub2api-observatory",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite\"",
    "build": "pnpm build:server && pnpm build:web",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.check.json --noEmit",
    "start": "node dist/server/index.js",
    "db:init": "tsx server/init.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/finance.test.ts tests/security.test.ts tests/adapter.test.ts tests/time.test.ts tests/checks.test.ts tests/account-access.test.ts",
    "test:api": "vitest run tests/api.test.ts",
    "test:db": "vitest run tests/mysql.test.ts",
    "setup": "node scripts/setup.mjs",
    "db:generate": "drizzle-kit generate",
    "worker": "node dist/server/worker.js",
    "format": "prettier --write src server shared tests scripts",
    "test:integration": "vitest run tests/api.test.ts tests/mysql.test.ts tests/reports.test.ts tests/exchange.test.ts tests/runtime.test.ts tests/operations.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.3.0",
    "@radix-ui/react-tooltip": "^1.2.8",
    "bullmq": "5.61.2",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.6.2",
    "ioredis": "5.8.2",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "^0.468.0",
    "mysql2": "3.15.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.3.0",
    "tailwind-merge": "^3.3.1",
    "undici": "^7.16.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^24.10.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "drizzle-kit": "0.31.6",
    "prettier": "3.6.2",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^3.2.4"
  }
}
